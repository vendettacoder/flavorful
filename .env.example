# Copy this file to .env. Never commit .env.
# Use the existing project's URL and publishable key from Supabase Settings > API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-PUBLISHABLE-KEY

# Required only for account deletion. Keep this key on the server.
SUPABASE_SERVICE_ROLE_KEY=

# Required for recipe extraction. Get a key from https://openrouter.ai/settings/keys.
OPEN_ROUTER_API_KEY=

# Exact browser origins. Do not use *. No browser origins are allowed if unset.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
